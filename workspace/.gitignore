# ==================================================================
# .gitignore for Claude Code Personal Configuration
# ==================================================================

# macOS folder view settings and metadata (auto-generated by Finder)
.DS_Store

# Process lock files generated by Claude Code during background tasks
*.lock
.claude/*.lock

# Session command audit log (keeps full history of executed tools locally)
*.log
.claude/command.log

# Cumulative tool execution statistics (tracked locally per machine)
session-stats.json
.claude/session-stats.json

# Daily tool-usage stats (JSONL, machine-local)
.claude/stats/

# Task log and execution plans (machine-local, not for version control)
tasks/task-log.jsonl
tasks/plans/

# Allowlist buffer pending suggestions (machine-local)
.claude/allowlist-pending.jsonl

